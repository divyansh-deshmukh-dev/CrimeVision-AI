# ── CrimeVision AI — Environment Configuration ────────────────────────────────
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Flask & Core Security ─────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Generate a strong random SECRET_KEY for production (required when FLASK_ENV=production):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret
SESSION_COOKIE_SECURE=0
TRUSTED_PROXIES=

# ── Production Database (PostgreSQL via SQLAlchemy) ───────────────────────────
# Leave empty for local SQLite (storage/crimevision.db).
# For production (Neon, Supabase, AWS RDS, Vercel Postgres):
#   postgresql://user:password@ep-host.region.aws.neon.tech/crimevision?sslmode=require
DATABASE_URL=

# ── Persistent Storage Backend (Local vs Amazon S3) ───────────────────────────
# Options: 'local' (filesystem in storage/) or 's3' (Amazon S3 / Cloudflare R2 / Supabase)
STORAGE_BACKEND=local
S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional custom endpoint (for Cloudflare R2, MinIO, or LocalStack)
S3_ENDPOINT_URL=

# ── Public Mentor Demo Account ────────────────────────────────────────────────
# Set to '1' to enable the "Launch Mentor Demo Workspace" button on /login
DEMO_LOGIN_ENABLED=1
DEMO_USERNAME=demo_mentor
DEMO_EMAIL=mentor.demo@crimevision.ai
DEMO_PASSWORD=change-me-to-a-strong-demo-password

# ── AI Chat Assistant (Phase 7) ───────────────────────────────────────────────
# Default provider is 'gemini' (using official google-genai SDK).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Groq API ──────────────────────────────────────────────────────────────────
# Required if AI_PROVIDER=groq or for Groq fallback.
GROQ_API_KEY=

# ── AI Model Identifiers (Phase 2+) ──────────────────────────────────────────
# Override these to use alternative / fine-tuned models.
RTDETR_MODEL_NAME=PekingU/rtdetr_r50vd
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
BLIP_MODEL_NAME=Salesforce/blip-image-captioning-base
WHISPER_MODEL_NAME=openai/whisper-base
